TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional endpoint override, e.g. a Vercel AI Gateway evaluate URL.
# TYPESAFE_URL=https://api.typesafe.ai/v1/systemone
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Raise when the helper truncates long reasoning traces (direct Mercury needs 4096).
# TEXT_MODEL_MAX_TOKENS=1024
# Server-side model-call logs: 1 = timing + tok/s, 2 = full request/response.
# JEV_DEBUG=1
# Open the owned tab in the foreground so a human can watch or take over (CAPTCHA).
# JEV_VISIBLE_TAB=1
# Walk open shadow roots. Set to 0 to skip them. Closed roots stay unsupported.
# JEV_SHADOW_DOM=1
# Frames: same (default, same-origin only), all (also cross-origin), or off.
# JEV_FRAMES=same
# File inputs are offered only when an allowlist is set. Keys are not paths.
# JEV_UPLOAD_FILES=resume=/absolute/resume.pdf
