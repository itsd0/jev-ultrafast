# TypeSafe is the default decision provider. Set mercury to opt into Mercury Decide.
INCEPTION_API_KEY=
# DECISION_PROVIDER=typesafe
# DECISION_PROVIDER=mercury
# DECISION_MODEL=mercury-decide
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional endpoint override, e.g. a Vercel AI Gateway evaluate URL.
# TYPESAFE_URL=https://api.typesafe.ai/v1/systemone
# Field text. INCEPTION_API_KEY is used for api.inceptionlabs.ai; TEXT_MODEL_API_KEY is the fallback.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.inceptionlabs.ai/v1
TEXT_MODEL=mercury-2.5
# instant, low, medium, or high. Other values use instant.
TEXT_MODEL_REASONING=instant
# Raise when the helper truncates long reasoning traces (direct Mercury needs 4096).
# TEXT_MODEL_MAX_TOKENS=1024
# Server-side model-call logs: 1 = timing + tok/s, 2 = full request/response.
# JEV_DEBUG=1
# Open the owned tab in the foreground so a human can watch or take over (CAPTCHA).
# JEV_VISIBLE_TAB=1
# Walk open shadow roots. Set to 0 to skip them. Closed roots stay unsupported.
# JEV_SHADOW_DOM=1
# Frames: same (default, same-origin only), all (also cross-origin), or off.
# JEV_FRAMES=same
# File inputs are offered only when an allowlist is set. Keys are not paths.
# JEV_UPLOAD_FILES=resume=/absolute/resume.pdf
# Follow pages opened by the owned tab (window.open, target=_blank). At most five tabs.
# JEV_TABS=1
# Offer scroll targets for up to eight overflow containers, plus the document.
# JEV_NESTED_SCROLL=1
# Retype when insertText does not stick, and offer Press Enter/Tab/Escape/arrows/Space/Backspace.
# JEV_KEYBOARD=1
# Collapse a native select above this many options into one SELECT_OPTION target.
# JEV_LARGE_SELECT=1
# JEV_SELECT_INLINE_MAX=12
# Coordinate clicks on canvas/svg. Off by default: this path does not use a node id.
# JEV_VISION=0
# Browser mode: local (default) or cloud. Cloud needs BROWSER_USE_API_KEY.
# JEV_BROWSER=cloud
# Cloud proxy country. "none" disables the managed proxy.
# JEV_CLOUD_PROXY_COUNTRY=us
# Session minutes (1-240).
# JEV_CLOUD_TIMEOUT_MIN=15
# JEV_CLOUD_PROFILE_ID=
# JEV_CLOUD_RECORD=0
# JSON object with host, port, optional username/password.
# JEV_CLOUD_CUSTOM_PROXY={"host":"proxy.example","port":8080}
# Print the liveUrl to stderr. It is never written to artifacts.
# JEV_CLOUD_SHOW_LIVE_URL=0
# Cloud mode disables uploads: the remote browser cannot read local paths.
